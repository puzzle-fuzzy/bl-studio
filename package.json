{
  "name": "bl-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": {
    "name": "烟熏三文鱼",
    "email": "18267094443@163.com",
    "url": "https://github.com/puzzle-fuzzy"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "dotenv -e infra/env/.env -- turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e infra/env/.env.test -- tsx infra/scripts/run-workflow.ts test",
    "test:root": "dotenv -e infra/env/.env.test -- vitest run tests infra/scripts --hookTimeout=30000",
    "test:coverage": "dotenv -e infra/env/.env.test -- tsx infra/scripts/run-workflow.ts coverage",
    "verify": "dotenv -e infra/env/.env.test -- tsx infra/scripts/run-workflow.ts verify",
    "check:boundaries": "tsx infra/scripts/check-package-boundaries.ts",
    "check:manifests": "tsx infra/scripts/check-model-manifests.ts",
    "check:db-migrations": "tsx infra/scripts/check-db-migrations.ts",
    "sync:bailian-docs": "tsx infra/scripts/sync-bailian-docs.ts",
    "docs:bailian:sync": "tsx infra/scripts/sync-bailian-official-docs.ts",
    "docs:bailian:check": "tsx infra/scripts/sync-bailian-official-docs.ts --check",
    "docs:bailian:snapshot:check": "tsx infra/scripts/sync-bailian-official-docs.ts --snapshot",
    "check:production-env": "tsx infra/scripts/check-production-env.ts",
    "model:acceptance": "tsx infra/scripts/model-acceptance.ts",
    "queue:health": "dotenv -e infra/env/.env -- tsx infra/scripts/queue-ops.ts health",
    "queue:retention": "dotenv -e infra/env/.env -- tsx infra/scripts/queue-ops.ts retention",
    "credits:reconcile": "dotenv -e infra/env/.env -- tsx infra/scripts/reconcile-credits.ts",
    "credits:release-stale": "dotenv -e infra/env/.env -- tsx infra/scripts/release-stale-reservations.ts",
    "admin:promote": "dotenv -e infra/env/.env -- tsx infra/scripts/promote-admin.ts",
    "seed:lan-test-accounts": "dotenv -e infra/env/.env -- tsx infra/scripts/seed-lan-test-accounts.ts",
    "e2e": "pnpm run db:push:test && node infra/scripts/playwright-cli.cjs test --config=e2e/playwright.config.ts",
    "e2e:install": "node infra/scripts/playwright-cli.cjs install chromium",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "db:push": "dotenv -e infra/env/.env -- pnpm exec drizzle-kit push --config packages/db/drizzle.config.ts && dotenv -e infra/env/.env -- tsx infra/scripts/ensure-audit-action-constraint.ts",
    "db:migrate": "dotenv -e infra/env/.env -- pnpm exec drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:migrate:production": "pnpm exec drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:baseline": "dotenv -e infra/env/.env -- tsx infra/scripts/db-baseline.ts",
    "db:studio": "dotenv -e infra/env/.env -- pnpm exec drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:test:up": "docker compose -f infra/docker/docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f infra/docker/docker-compose.test.yml down -v",
    "db:push:test": "dotenv -e infra/env/.env.test -- pnpm exec drizzle-kit push --config packages/db/drizzle.config.ts && dotenv -e infra/env/.env.test -- tsx infra/scripts/ensure-audit-action-constraint.ts",
    "db:migrate:test": "dotenv -e infra/env/.env.test -- pnpm exec drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:baseline:test": "dotenv -e infra/env/.env.test -- tsx infra/scripts/db-baseline.ts",
    "db:studio:test": "dotenv -e infra/env/.env.test -- pnpm exec drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:backfill:credits": "dotenv -e infra/env/.env -- tsx infra/scripts/backfill-credit-accounts.ts",
    "deploy:rehearsal:up": "docker compose -f infra/docker/docker-compose.rehearsal.yml build api web && docker compose -f infra/docker/docker-compose.rehearsal.yml up -d --no-build --pull never",
    "deploy:rehearsal:down": "docker compose -f infra/docker/docker-compose.rehearsal.yml down",
    "deploy:rehearsal:ps": "docker compose -f infra/docker/docker-compose.rehearsal.yml ps",
    "deploy:rehearsal:smoke": "tsx infra/scripts/rehearsal-smoke.ts",
    "deploy:prod": "bash infra/scripts/deploy-prod.sh",
    "deploy:prod:web": "bash infra/scripts/deploy-prod-web.sh",
    "deploy:rollback": "bash infra/scripts/deploy-rollback.sh",
    "prod:status": "bash infra/scripts/prod-status.sh",
    "prod:sync-dashscope-key": "bash infra/scripts/sync-dashscope-key.sh",
    "check:production-env:infra": "tsx infra/scripts/check-production-env.ts infra",
    "prod:up": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml up -d --no-build --pull never",
    "prod:down": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml down",
    "prod:ps": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml ps",
    "prod:logs": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml logs -f --tail=100",
    "prod:observability:up": "bash infra/scripts/prod-observability.sh up",
    "prod:observability:down": "bash infra/scripts/prod-observability.sh down",
    "logs:api": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml logs -f api",
    "logs:worker": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml logs -f worker",
    "logs:prune": "bash infra/scripts/prune-loki-logs.sh",
    "prod:mem": "dotenv -e infra/env/.env.prod-infra -- tsx infra/scripts/prod-mem.ts",
    "db:backup:production": "docker compose --env-file infra/env/.env.prod-infra -f infra/docker/docker-compose.prod.yml exec -T backup /bin/sh /usr/local/bin/backup-postgres.sh",
    "prod:restore:rehearsal": "bash infra/scripts/restore-rehearsal.sh",
    "db:seed:model-costs": "dotenv -e infra/env/.env -- tsx infra/scripts/seed-model-costs.ts",
    "fetch:static-ffmpeg:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/fetch-static-ffmpeg.ps1"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "postgres": "catalog:",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@bailian-studio/generation-repository": "workspace:*",
    "@bailian-studio/shared": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.10.8",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puzzle-fuzzy/bl-studio"
  }
}
