{
  "name": "bl-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": {
    "name": "烟熏三文鱼",
    "email": "18267094443@163.com",
    "url": "https://github.com/puzzle-fuzzy"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0 <26.0.0"
  },
  "scripts": {
    "dev": "dotenv -e deploy/env/.env.dev -- turbo run dev",
    "dev:smoke": "dotenv -e deploy/env/.env.dev -- tsx scripts/verify/dev-smoke.ts",
    "build": "turbo run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "check:workspace-deps": "tsx scripts/verify/check-workspace-dependencies.ts",
    "test": "dotenv -e deploy/env/.env.test -- tsx scripts/verify/run-workflow.ts test",
    "test:root": "dotenv -e deploy/env/.env.test -- vitest run tests scripts --exclude='**/tests/e2e/**' --exclude='tools/**' --exclude='reference-materials/**' --hookTimeout=30000",
    "test:coverage": "dotenv -e deploy/env/.env.test -- tsx scripts/verify/run-workflow.ts coverage",
    "verify": "dotenv -e deploy/env/.env.test -- tsx scripts/verify/run-workflow.ts verify",
    "check:boundaries": "tsx scripts/verify/check-package-boundaries.ts",
    "check:local-capture-boundary": "tsx scripts/verify-local-capture-boundary.ts",
    "check:manifests": "tsx scripts/verify/check-model-manifests.ts",
    "check:db-migrations": "tsx scripts/verify/check-db-migrations.ts",
    "sync:bailian-docs": "tsx scripts/docs/sync-bailian-docs.ts",
    "docs:bailian:sync": "tsx scripts/docs/sync-bailian-official-docs.ts",
    "docs:bailian:check": "tsx scripts/docs/sync-bailian-official-docs.ts --check",
    "docs:bailian:snapshot:check": "tsx scripts/docs/sync-bailian-official-docs.ts --snapshot",
    "check:production-env": "tsx scripts/verify/check-production-env.ts",
    "model:acceptance": "tsx scripts/verify/model-acceptance.ts",
    "queue:health": "dotenv -e deploy/env/.env.dev -- tsx scripts/deploy/queue-ops.ts health",
    "queue:retention": "dotenv -e deploy/env/.env.dev -- tsx scripts/deploy/queue-ops.ts retention",
    "credits:reconcile": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/reconcile-credits.ts",
    "credits:release-stale": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/release-stale-reservations.ts",
    "admin:promote": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/promote-admin.ts",
    "seed:lan-test-accounts": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/seed-lan-test-accounts.ts",
    "e2e": "tsx scripts/verify/run-e2e.ts",
    "e2e:install": "node scripts/verify/playwright-cli.cjs install chromium",
    "db:up": "docker compose -f deploy/docker/compose.yaml up -d",
    "db:down": "docker compose -f deploy/docker/compose.yaml down",
    "db:reset": "docker compose -f deploy/docker/compose.yaml down -v",
    "db:push": "dotenv -e deploy/env/.env.dev -- bunx drizzle-kit push --config packages/db/drizzle.config.ts && dotenv -e deploy/env/.env.dev -- tsx scripts/db/ensure-audit-action-constraint.ts",
    "db:migrate": "dotenv -e deploy/env/.env.dev -- bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:migrate:production": "bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:baseline": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/db-baseline.ts",
    "db:studio": "dotenv -e deploy/env/.env.dev -- bunx drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:test:up": "docker compose -f deploy/docker/compose.test.yaml up -d",
    "db:test:down": "docker compose -f deploy/docker/compose.test.yaml down -v",
    "db:push:test": "dotenv -e deploy/env/.env.test -- bunx drizzle-kit push --config packages/db/drizzle.config.ts && dotenv -e deploy/env/.env.test -- tsx scripts/db/ensure-audit-action-constraint.ts",
    "db:migrate:test": "dotenv -e deploy/env/.env.test -- bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:baseline:test": "dotenv -e deploy/env/.env.test -- tsx scripts/db/db-baseline.ts",
    "db:studio:test": "dotenv -e deploy/env/.env.test -- bunx drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:backfill:credits": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/backfill-credit-accounts.ts",
    "deploy:rehearsal:up": "docker compose -f deploy/docker/compose.rehearsal.yaml build api web && docker compose -f deploy/docker/compose.rehearsal.yaml up -d --no-build --pull never",
    "deploy:rehearsal:down": "docker compose -f deploy/docker/compose.rehearsal.yaml down",
    "deploy:rehearsal:ps": "docker compose -f deploy/docker/compose.rehearsal.yaml ps",
    "deploy:rehearsal:smoke": "tsx scripts/deploy/rehearsal-smoke.ts",
    "deploy:prod": "bash scripts/deploy/deploy-prod.sh",
    "deploy:prod:web": "bash scripts/deploy/deploy-prod-web.sh",
    "deploy:rollback": "bash scripts/deploy/deploy-rollback.sh",
    "prod:status": "bash scripts/deploy/prod-status.sh",
    "prod:sync-dashscope-key": "bash scripts/deploy/sync-dashscope-key.sh",
    "check:production-env:infra": "tsx scripts/verify/check-production-env.ts infra",
    "prod:up": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml up -d --no-build --pull never",
    "prod:down": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml down",
    "prod:ps": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml ps",
    "prod:logs": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml logs -f --tail=100",
    "prod:observability:up": "bash scripts/deploy/prod-observability.sh up",
    "prod:observability:down": "bash scripts/deploy/prod-observability.sh down",
    "prod:observability:smoke": "bash scripts/deploy/prod-observability.sh smoke",
    "prod:observability:baseline": "bash scripts/deploy/prod-observability.sh baseline",
    "logs:api": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml logs -f api",
    "logs:worker": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml logs -f worker",
    "logs:prune": "bash scripts/backup/prune-loki-logs.sh",
    "prod:mem": "dotenv -e deploy/env/.env.prod -- tsx scripts/deploy/prod-mem.ts",
    "db:backup:production": "docker compose --env-file deploy/env/.env.prod -f deploy/docker/compose.prod.yaml exec -T backup /bin/sh /usr/local/bin/backup-postgres.sh",
    "prod:restore:rehearsal": "bash scripts/deploy/restore-rehearsal.sh",
    "db:seed:model-costs": "dotenv -e deploy/env/.env.dev -- tsx scripts/db/seed-model-costs.ts",
    "fetch:static-ffmpeg:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/fetch-static-ffmpeg.ps1"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "postgres": "catalog:",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@bailian-studio/generation-repository": "workspace:*",
    "@bailian-studio/shared": "workspace:*",
    "@biomejs/biome": "^2.5.7",
    "@node-rs/argon2": "catalog:",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.10.8",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puzzle-fuzzy/bl-studio"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@node-rs/argon2": "^2.0.2",
      "@types/ali-oss": "^6.23.3",
      "@types/nodemailer": "8.0.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "@vitest/coverage-v8": "^4.1.10",
      "ali-oss": "^6.23.0",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "elysia": "^1.4.29",
      "lucide-react": "^1.28.0",
      "nodemailer": "9.0.3",
      "postgres": "^3.4.9",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-router": "^8.3.0",
      "react-window": "^2.3.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.2.0",
      "vitest": "^4.1.10",
      "zod": "^4.4.3",
      "zustand": "^5.0.14",
      "@tanstack/react-query": "^5.0.0",
      "@xyflow/react": "^12.11.5"
    }
  }
}
