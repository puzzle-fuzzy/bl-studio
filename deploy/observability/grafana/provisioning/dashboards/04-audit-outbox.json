        "datasource": { "type": "loki", "uid": "lokiuid" },
        "definition": "label_values(container)",
        "hide": 0,
        "includeAll": true,
        "label": "Worker",
        "multi": true,
        "name": "container",
        "options": [],
        "query": { "query": "label_values(container)", "refId": "container-var" },
        "refresh": 2,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
