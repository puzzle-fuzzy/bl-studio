# 基础开发配置模板。复制为 deploy/env/.env.dev 或 deploy/env/.env.test 后再补充本地值。
# 生产部署使用 deploy/env/.env.prod（应用、数据库、备份和部署参数统一在同一文件）。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5003
DATABASE_URL=postgres://bailian-studio:bailian-studio@127.0.0.1:55431/bailian-studio_dev
DASHSCOPE_API_KEY=
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:5002
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM=no-reply@localhost
CORS_ALLOWED_ORIGINS=http://localhost:5002,http://localhost:5004,http://localhost:5006,http://localhost:5007
VITE_API_ORIGIN=
VITE_WEB_ORIGIN=http://localhost:5002
