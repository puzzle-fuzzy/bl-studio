{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DASHSCOPE_API_KEY",
    "BAILIAN_WORKSPACE_ID",
    "ERROR_LOCALE",
    "WORKER_ID",
    "WORKER_POLL_INTERVAL_MS",
    "WORKER_IDLE_SLEEP_MS",
    "WORKER_LOCK_DURATION_MS",
    "DASHSCOPE_BASE_URL",
    "OSS_REGION",
    "OSS_BUCKET",
    "OSS_ACCESS_KEY_ID",
    "OSS_ACCESS_KEY_SECRET",
    "OSS_ENDPOINT",
    "ARTIFACT_LOCAL_ROOT",
    "ARTIFACT_LOCAL_PUBLIC_BASE_URL",
    "AUTH_JWT_SECRET",
    "AUTH_PUBLIC_WEB_ORIGIN",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "API_HOST",
    "API_PORT",
    "API_TRUST_PROXY",
    "COOKIE_SECURE",
    "CORS_ALLOWED_ORIGINS",
    "API_RATE_LIMIT_ENABLED",
    "OSS_KEY_PREFIX",
    "GENERATION_DAILY_TASK_LIMIT",
    "GENERATION_DAILY_COST_LIMIT_CENTS",
    "GENERATION_DAILY_QUOTA_MODE",
    "VITE_API_ORIGIN",
    "VITE_WEB_ORIGIN",
    "E2E_API_ORIGIN",
    "E2E_WEB_ORIGIN",
    "E2E_CANVAS_ORIGIN",
    "E2E_REUSE_EXISTING_SERVER",
    "VITE_LEGAL_ENTITY",
    "VITE_LEGAL_CONTACT_EMAIL",
    "VITE_LEGAL_EFFECTIVE_DATE",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@bailian-studio/auth#build": { "outputs": [] },
    "@bailian-studio/creative-asset-repository#build": { "outputs": [] },
    "@bailian-studio/credit-ledger#build": { "outputs": [] },
    "@bailian-studio/db#build": { "outputs": [] },
    "@bailian-studio/director-repository#build": { "outputs": [] },
    "@bailian-studio/generation-repository#build": { "outputs": [] },
    "@bailian-studio/media-repository#build": { "outputs": [] },
    "@bailian-studio/persistence-runtime#build": { "outputs": [] },
    "@bailian-studio/storage#build": { "outputs": [] },
    "@bailian-studio/api#build": { "outputs": [] },
    "@bailian-studio/worker#build": { "outputs": [] },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {},
    "test:coverage": {},
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
