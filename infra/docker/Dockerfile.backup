# 生产 PostgreSQL 备份镜像。
#
# 与业务 runtime 镜像隔离：只包含 PostgreSQL 16 pg_dump/gzip、Node/tsx 和 ali-oss 上传器，
# 不把 API/Worker/SMTP/provider 凭据或前端依赖带进备份容器。
FROM postgres:16-alpine

ENV NODE_ENV=production
WORKDIR /opt/bailian-studio

RUN apk add --no-cache nodejs npm gzip ca-certificates

COPY infra/docker/backup-package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

COPY infra/scripts/backup-postgres.sh /usr/local/bin/backup-postgres.sh
COPY infra/scripts/upload-backup-to-oss.ts /opt/bailian-studio/upload-backup-to-oss.ts
RUN chmod 0755 /usr/local/bin/backup-postgres.sh

ARG BAILIAN_STUDIO_RELEASE_TAG=unknown
LABEL org.opencontainers.image.revision="${BAILIAN_STUDIO_RELEASE_TAG}"
