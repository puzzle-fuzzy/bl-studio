# ── Database ──────────────────────────────────────────────────────
# Postgres connection. Test DB is on :55432 (bailian-studio_test).
DATABASE_URL=postgres://bailian-studio:bailian-studio@127.0.0.1:55432/bailian-studio_test

# ── DashScope provider ────────────────────────────────────────────
# The test suite does not call the provider.
DASHSCOPE_API_KEY=
# Optional in tests; required only when exercising workspace-scoped models.
BAILIAN_WORKSPACE_ID=
# Contract v3 校验提示语言：zh-CN 或 en-US。
BAILIAN_CONTRACT_LOCALE=zh-CN
# Logical worker id; empty => a generated default.
WORKER_ID=
# Worker timeout overrides in milliseconds. Empty => production defaults are used.
DASHSCOPE_REQUEST_TIMEOUT_MS=
GENERATION_SUBMIT_TIMEOUT_MS=
PROVIDER_ASYNC_MAX_DURATION_MS=
ARTIFACT_PERSIST_TIMEOUT_MS=
# Provider artifact fetch guardrails (empty => code defaults).
ARTIFACT_FETCH_MAX_BYTES=
ARTIFACT_FETCH_TIMEOUT_MS=
ARTIFACT_FETCH_MAX_REDIRECTS=
ARTIFACT_FETCH_ALLOWED_HOSTS=
# Optional task lease heartbeat override. Empty => one third of the lock duration.
WORKER_LOCK_HEARTBEAT_MS=
# Worker liveness heartbeat interval. Empty => 5s.
WORKER_HEARTBEAT_INTERVAL_MS=

# ── Auth (cookie + JWT sessions) ──────────────────────────────────
# Required to start the API even under test; keep a fixed value for determinism.
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:5002
# Route/domain tests inject an in-memory sender and never connect to SMTP.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Keep test runs unlimited unless a specific quota scenario is being tested.
GENERATION_DAILY_TASK_LIMIT=0
GENERATION_DAILY_COST_LIMIT_CENTS=0
# Empty: tests run over HTTP.
COOKIE_SECURE=

# ── CORS ──────────────────────────────────────────────────────────
# Empty => localhost default; the suite does not rely on CORS.
CORS_ALLOWED_ORIGINS=

# ── Artifact storage: local filesystem ────────────────────────────
# Empty => default `var/artifacts` / `/api/artifacts/local`.
ARTIFACT_LOCAL_ROOT=
ARTIFACT_LOCAL_PUBLIC_BASE_URL=

# Audio/video duration probe. Tests inject the probe and do not call ffprobe.
MEDIA_MAX_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe

# ── Artifact storage: Aliyun OSS (optional) ───────────────────────
# Not exercised by the test suite.
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
# Key prefix for all OSS objects. Empty => no prefix. Default in code: "bailian-studio".
OSS_KEY_PREFIX=

# ── Client origins (Vite) ─────────────────────────────────────────
# Provided for parity; the suite does not run the Vite dev server.
VITE_API_ORIGIN=http://localhost:5003
VITE_WEB_ORIGIN=http://localhost:5002
