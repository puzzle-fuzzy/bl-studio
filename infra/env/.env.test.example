# ── 数据库 ───────────────────────────────────────────────────────
# Postgres 连接串。测试库在 :55432（bailian-studio_test）。
DATABASE_URL=postgres://bailian-studio:bailian-studio@127.0.0.1:55432/bailian-studio_test

# ── DashScope provider ─────────────────────────────────────────────
# 测试套件不调用 provider。
DASHSCOPE_API_KEY=
# 测试中可选；仅当覆盖 workspace 级模型时才需要。
BAILIAN_WORKSPACE_ID=
# 错误提示语言：zh-CN 或 en-US。
ERROR_LOCALE=zh-CN
# 逻辑 worker 标识；留空则自动生成。
WORKER_ID=
# Worker 超时覆盖（毫秒）。留空使用代码默认值。
DASHSCOPE_REQUEST_TIMEOUT_MS=
GENERATION_SUBMIT_TIMEOUT_MS=
PROVIDER_ASYNC_MAX_DURATION_MS=
ARTIFACT_PERSIST_TIMEOUT_MS=
# provider 产物抓取护栏（留空使用代码默认值）。
ARTIFACT_FETCH_MAX_BYTES=
ARTIFACT_FETCH_TIMEOUT_MS=
ARTIFACT_FETCH_MAX_REDIRECTS=
ARTIFACT_FETCH_ALLOWED_HOSTS=
# 可选的租约心跳覆盖。留空为锁时长的三分之一。
WORKER_LOCK_HEARTBEAT_MS=
# worker 存活心跳间隔。留空默认 5s。
WORKER_HEARTBEAT_INTERVAL_MS=

# ── 认证（cookie + JWT 会话）─────────────────────────────────────
# 即使测试也需启动 API；保持固定值以保确定性。
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:5002
# 路由/领域测试注入内存发件器，不连 SMTP。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 除非测试特定配额场景，否则保持测试不限量。
GENERATION_DAILY_TASK_LIMIT=0
GENERATION_DAILY_COST_LIMIT_CENTS=0
# 留空：测试走 HTTP。
COOKIE_SECURE=

# ── CORS ──────────────────────────────────────────────────────────
# 留空使用 localhost 默认；测试套件不依赖 CORS。
CORS_ALLOWED_ORIGINS=

# ── 产物存储：本地文件系统 ───────────────────────────────────────
# 留空默认 `var/artifacts` / `/api/artifacts/local`。
ARTIFACT_LOCAL_ROOT=
ARTIFACT_LOCAL_PUBLIC_BASE_URL=

# 音频/视频时长探测。测试注入探测实现，不调用 ffprobe。
MEDIA_MAX_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe

# ── 产物存储：阿里云 OSS（可选）──────────────────────────────────
# 测试套件不覆盖。
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
# 所有 OSS 对象的 key 前缀。留空无前缀。代码默认："bailian-studio"。
OSS_KEY_PREFIX=

# ── 客户端 Origin（Vite）─────────────────────────────────────────
# 为对齐而保留；测试套件不运行 Vite 开发服务器。
VITE_API_ORIGIN=http://localhost:5003
VITE_WEB_ORIGIN=http://localhost:5002
