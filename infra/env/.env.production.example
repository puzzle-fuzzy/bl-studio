# Copy this file to `.env.production`; never commit the copied file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=5003

# Immutable image identity. Replace this with `git rev-parse HEAD`; production
# preflight rejects latest, branch names, short SHAs, dirty trees and mismatches.
BAILIAN_STUDIO_RELEASE_TAG=replace-with-full-git-commit-sha

# External Postgres. Run backup + `bun run db:migrate:production` first.
DATABASE_URL=postgres://bailian-studio:CHANGE_ME@db.example.internal:5432/bailian-studio

# DashScope / Bailian
DASHSCOPE_API_KEY=replace-with-real-key
BAILIAN_WORKSPACE_ID=
BAILIAN_CONTRACT_LOCALE=zh-CN
DASHSCOPE_BASE_URL=
WORKER_ID=bailian-studio-worker-1
WORKER_POLL_INTERVAL_MS=100
WORKER_IDLE_SLEEP_MS=1000
WORKER_LOCK_DURATION_MS=90000
# Provider artifact download guardrails. Set explicit values for production.
ARTIFACT_FETCH_MAX_BYTES=104857600
ARTIFACT_FETCH_TIMEOUT_MS=30000
ARTIFACT_FETCH_MAX_REDIRECTS=3
# Comma-separated HTTPS provider hosts in addition to DashScope result hosts.
ARTIFACT_FETCH_ALLOWED_HOSTS=

# Cookie and request safety
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_PUBLIC_WEB_ORIGIN=https://create.yxswy.com
COOKIE_SECURE=true
CSRF_REQUIRE_ORIGIN=true
CORS_ALLOWED_ORIGINS=https://create.yxswy.com
API_RATE_LIMIT_ENABLED=true
# Only enable when the reverse proxy overwrites the client-IP headers.
API_TRUST_PROXY=true

# Transactional account email. SMTP_PASS is a 163 client authorization code,
# never the mailbox login password.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-163-address
SMTP_PASS=replace-with-163-client-authorization-code
SMTP_FROM=Bailian Studio <replace-with-163-address>

# Personal default: no daily cost cap. Add a positive value only when the team
# needs a soft UTC-day guardrail, measured in integer CNY cents.
GENERATION_DAILY_TASK_LIMIT=0
GENERATION_DAILY_COST_LIMIT_CENTS=0

# Storage is mandatory in production; local fallback is rejected.
OSS_REGION=replace-with-oss-region
OSS_BUCKET=replace-with-oss-bucket
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
OSS_ENDPOINT=
OSS_KEY_PREFIX=bailian-studio

# Upload validation and runtime safety defaults.
MEDIA_MAX_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe
API_MAX_JSON_BODY_BYTES=2097152
API_MAX_MULTIPART_BODY_BYTES=125829120
API_MAX_OTHER_BODY_BYTES=8388608
ARTIFACT_MAX_READ_BYTES=104857600

# Empty makes the Web image call the same-origin `/api`; Nginx forwards it to
# the API container. Set an absolute API origin only for split-origin hosting.
VITE_API_ORIGIN=
VITE_WEB_ORIGIN=https://create.yxswy.com
