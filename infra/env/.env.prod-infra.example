# 复制此文件为 `.env.prod-infra`；切勿提交复制后的文件。
# 这是**基础设施专用** env：只进入 caddy/grafana/loki/alloy/postgres/backup 容器与
# compose 变量插值，**不进入应用容器**（应用机密见 .env.production）。
# 发布预检：`pnpm run check:production-env:infra`。

# 应用/日志域名。两个域名都需先把 DNS A 记录指向服务器。
SITE_DOMAIN=create.yxswy.com
LOGS_DOMAIN=logs.yxswy.com

# Let's Encrypt 证书通知邮箱（setup-host-edge.sh 签发 create/logs 证书用）。
LE_EMAIL=replace-with-your-email

# Grafana 管理员账号。logs.yxswy.com 入口的 basic_auth 密码 = 此密码
# （setup-host-edge.sh 在服务器上用 openssl 生成 apr1 htpasswd，明文不进服务器文件）。
GRAFANA_ADMIN_USER=viewer
GRAFANA_ADMIN_PASSWORD=replace-with-at-least-12-characters

# 生产 Postgres 凭据。POSTGRES_PASSWORD 必须与 .env.production 的
# DATABASE_URL 内嵌密码一致（预检只验格式，不做交叉比对，需人工确认）。
POSTGRES_USER=bailian-studio
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=bailian-studio

# 每日备份。BACKUP_DIR 是容器内备份卷路径；保留 N 天。
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# 开启后仅在服务器存在 ossutil/aliyun CLI 时才上传 OSS（凭据由环境配置）。
BACKUP_OSS_UPLOAD=false
# 说明性保留期提示：Loki 实际保留值写死在 infra/loki/loki.yaml（不支持 ${}）。
LOKI_RETENTION_DAYS=31

# 部署目标（deploy-prod.sh 读取）。格式 user@host；可另配 SSH key 路径。
DEPLOY_HOST=replace-with-user@host
DEPLOY_REMOTE_DIR=/opt/bailian-studio
DEPLOY_SSH_KEY=
# 目标服务器 CPU 架构（docker build --platform 用）。本机 arm64 → 服务器 x86_64 时必须
# 显式 linux/amd64，否则产出的 arm64 镜像无法在 x64 服务器上运行。本机与服务器同架构可留空。
DEPLOY_PLATFORM=linux/amd64

# 发布 tag 由 deploy-prod.sh 自动注入当前 commit SHA，无需手工填写。
BAILIAN_STUDIO_RELEASE_TAG=
