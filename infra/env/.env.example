# Runtime mode. Use `production` only with HTTPS, explicit CORS, and complete OSS config.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5003

# ── Database ──────────────────────────────────────────────────────
# Postgres connection. Dev DB is on :55431 (bailian-studio_dev).
DATABASE_URL=postgres://bailian-studio:bailian-studio@127.0.0.1:55431/bailian-studio_dev

# ── DashScope provider ────────────────────────────────────────────
# API key from https://bailian.console.aliyun.com. Empty => provider calls fail.
DASHSCOPE_API_KEY=
# Required only by workspace-scoped models such as HappyHorse.
BAILIAN_WORKSPACE_ID=
# Contract v3 校验提示语言：zh-CN 或 en-US。
BAILIAN_CONTRACT_LOCALE=zh-CN
# Optional provider API root for a compatible proxy; default is the official endpoint.
DASHSCOPE_BASE_URL=
# Logical worker id; empty => a generated default.
WORKER_ID=
WORKER_POLL_INTERVAL_MS=
WORKER_IDLE_SLEEP_MS=
WORKER_LOCK_DURATION_MS=
# Request and lifecycle safety rails in milliseconds. Empty => code defaults:
# request 60s, submit 2m, provider async 30m, artifact persistence 15m.
DASHSCOPE_REQUEST_TIMEOUT_MS=
GENERATION_SUBMIT_TIMEOUT_MS=
PROVIDER_ASYNC_MAX_DURATION_MS=
ARTIFACT_PERSIST_TIMEOUT_MS=
# Provider artifact download guardrails. Empty values use code defaults:
# 100 MiB per artifact, 30s fetch/stream deadline, 3 validated redirects.
ARTIFACT_FETCH_MAX_BYTES=
ARTIFACT_FETCH_TIMEOUT_MS=
ARTIFACT_FETCH_MAX_REDIRECTS=
# Optional comma-separated HTTPS hostnames for provider artifact URLs.
# DashScope result hosts are allowed by their strict result-host pattern.
ARTIFACT_FETCH_ALLOWED_HOSTS=
# Worker liveness heartbeat interval. Empty => 5s.
WORKER_HEARTBEAT_INTERVAL_MS=

# ── Auth (cookie + JWT sessions) ──────────────────────────────────
# Required to start the API. Use a long random string in real envs; local dev only.
AUTH_JWT_SECRET=dev-secret-change-me
# Trusted frontend origin used to construct verification/reset links. Never derive this from request Host.
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:5002
# Development uses the local Mailpit container from infra/docker/docker-compose.yml.
# Open http://localhost:18025 to inspect verification/reset messages.
# Production must replace these with a real authenticated SMTP provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional display/from address. Empty => no-reply@localhost in development.
SMTP_FROM=Bailian Studio <no-reply@localhost>
# Per-user UTC-day safety rails. Personal default is intentionally unlimited;
# 0/empty disables a limit. If the team later needs a soft guardrail, for example
# 1000000 means ¥10,000/day rather than a restrictive personal quota.
GENERATION_DAILY_TASK_LIMIT=0
GENERATION_DAILY_COST_LIMIT_CENTS=0
# `true` in production (HTTPS) so the cookie carries Secure. Empty for local HTTP.
COOKIE_SECURE=
# Reject cookie-authenticated writes without a trusted Origin/Referer. Required in production.
CSRF_REQUIRE_ORIGIN=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty => localhost:5002 default.
CORS_ALLOWED_ORIGINS=

# ── API request guards ─────────────────────────────────────────────
# Content-Length guardrails. JSON defaults to 2 MiB, multipart to 120 MiB,
# other bodies to 8 MiB. Upload files have a separate 100 MiB service limit.
API_MAX_JSON_BODY_BYTES=2097152
API_MAX_MULTIPART_BODY_BYTES=125829120
API_MAX_OTHER_BODY_BYTES=8388608
# Process-local fixed-window limiter. Production defaults are stricter; keep enabled.
API_RATE_LIMIT_ENABLED=true
API_TRUST_PROXY=false
API_RATE_LIMIT_REQUESTS_PER_MINUTE=
API_RATE_LIMIT_AUTH_PER_MINUTE=
API_RATE_LIMIT_GENERATIONS_PER_MINUTE=
API_RATE_LIMIT_UPLOADS_PER_MINUTE=

# ── Artifact storage: local filesystem ────────────────────────────
# Empty ROOT => `var/artifacts`. Empty PUBLIC_BASE_URL => `/api/artifacts/local`.
# Local storage is for development only; NODE_ENV=production rejects OSS fallback.
ARTIFACT_LOCAL_ROOT=
ARTIFACT_LOCAL_PUBLIC_BASE_URL=
# Maximum local artifact bytes served by the API. Empty uses 100 MiB.
ARTIFACT_MAX_READ_BYTES=104857600

# ── Uploaded media validation ─────────────────────────────────────
# Audio/video uploads are probed server-side with ffprobe before storage.
# Default max duration is 1800 seconds; set 0 to disable the duration limit.
MEDIA_MAX_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe

# ── Artifact storage: Aliyun OSS (required in production) ─────────
# Leave all empty only in development to use the local filesystem adapter above.
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
# Key prefix for all OSS objects. Empty => no prefix. Default in code: "bailian-studio".
OSS_KEY_PREFIX=

# ── Client origins (Web/Vite) ─────────────────────────────────────
# Vite injects the API origin into apps/web。留空 = 同源：开发由 vite 代理 /api，
# 生产由 nginx 反代 /api，会话 cookie 同源携带。跨源部署时填完整 API origin。
# VITE_WEB_ORIGIN 仅作为 API auth-origin 兼容回退；优先用 AUTH_PUBLIC_WEB_ORIGIN。
VITE_API_ORIGIN=
VITE_WEB_ORIGIN=http://localhost:5002
