# 运行模式。仅在使用 HTTPS、显式 CORS 与完整 OSS 配置时才用 production。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5003

# ── 数据库 ───────────────────────────────────────────────────────
# Postgres 连接串。开发库在 :55431（bailian-studio_dev）。
DATABASE_URL=postgres://bailian-studio:bailian-studio@127.0.0.1:55431/bailian-studio_dev

# ── DashScope provider ─────────────────────────────────────────────
# API Key，来自 https://bailian.console.aliyun.com。留空则 provider 调用失败。
DASHSCOPE_API_KEY=
# 仅 workspace 级模型（如 HappyHorse）需要。
BAILIAN_WORKSPACE_ID=
# 错误提示语言：zh-CN 或 en-US。
ERROR_LOCALE=zh-CN
# 可选的 provider API 根地址（用于兼容代理）；默认官方端点。
DASHSCOPE_BASE_URL=
# 逻辑 worker 标识；留空则自动生成。
WORKER_ID=
WORKER_POLL_INTERVAL_MS=
WORKER_IDLE_SLEEP_MS=
WORKER_LOCK_DURATION_MS=
# 任务锁租约心跳间隔（毫秒）。留空为锁时长的三分之一。
WORKER_LOCK_HEARTBEAT_MS=
# 请求与生命周期安全护栏（毫秒）。留空使用代码默认值：
# 请求 60s、提交 2m、provider 异步 30m、产物持久化 15m。
DASHSCOPE_REQUEST_TIMEOUT_MS=
GENERATION_SUBMIT_TIMEOUT_MS=
PROVIDER_ASYNC_MAX_DURATION_MS=
ARTIFACT_PERSIST_TIMEOUT_MS=
# provider 产物下载护栏。留空使用代码默认值：
# 每个产物 100 MiB、抓取/流式截止 30s、最多 3 次校验过的重定向。
ARTIFACT_FETCH_MAX_BYTES=
ARTIFACT_FETCH_TIMEOUT_MS=
ARTIFACT_FETCH_MAX_REDIRECTS=
# 可选的逗号分隔 HTTPS 主机白名单，用于 provider 产物 URL。
# DashScope 结果主机已由其严格的 result-host 模式放行。
ARTIFACT_FETCH_ALLOWED_HOSTS=
# worker 存活心跳间隔。留空默认 5s。
WORKER_HEARTBEAT_INTERVAL_MS=

# ── 认证（cookie + JWT 会话）─────────────────────────────────────
# 启动 API 必需。真实环境请用长随机串；以下仅限本地开发。
AUTH_JWT_SECRET=dev-secret-change-me
# 可信前端 Origin，用于构造验证/重置链接。绝不可从请求 Host 推导。
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:5002
# 开发使用 infra/docker/docker-compose.yml 里的本地 Mailpit 容器。
# 打开 http://localhost:18025 查看验证/重置邮件。
# 生产必须替换为真实认证过的 SMTP 服务商。
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 可选的展示/发件人地址。留空在开发环境使用 no-reply@localhost。
SMTP_FROM=Bailian Studio <no-reply@localhost>
# 每用户 UTC 日安全护栏。个人默认故意不限；0/留空表示关闭。
# 若团队需要软护栏，例如 1000000 表示每天 ¥10000，而非限制性个人配额。
GENERATION_DAILY_TASK_LIMIT=0
GENERATION_DAILY_COST_LIMIT_CENTS=0
# 生产（HTTPS）设 true 使 cookie 带 Secure。本地 HTTP 留空。
COOKIE_SECURE=
# 生产必需：拒绝未带可信 Origin/Referer 的 cookie 写请求。
CSRF_REQUIRE_ORIGIN=

# ── CORS ──────────────────────────────────────────────────────────
# 逗号分隔的允许 Origin。留空默认 localhost:5002。
CORS_ALLOWED_ORIGINS=

# ── API 请求护栏 ──────────────────────────────────────────────────
# Content-Length 护栏。JSON 默认 2 MiB、multipart 120 MiB、其它 8 MiB。
# 上传文件另有 100 MiB 的服务端限制。
API_MAX_JSON_BODY_BYTES=2097152
API_MAX_MULTIPART_BODY_BYTES=125829120
API_MAX_OTHER_BODY_BYTES=8388608
# 进程内固定窗口限流器。生产默认更严格；保持开启。
API_RATE_LIMIT_ENABLED=true
API_TRUST_PROXY=false
API_RATE_LIMIT_REQUESTS_PER_MINUTE=
API_RATE_LIMIT_AUTH_PER_MINUTE=
API_RATE_LIMIT_GENERATIONS_PER_MINUTE=
API_RATE_LIMIT_UPLOADS_PER_MINUTE=

# ── 产物存储：本地文件系统 ───────────────────────────────────────
# ROOT 留空默认 `var/artifacts`；PUBLIC_BASE_URL 留空默认 `/api/artifacts/local`。
# 本地存储仅供开发；NODE_ENV=production 时拒绝回退到本地。
ARTIFACT_LOCAL_ROOT=
ARTIFACT_LOCAL_PUBLIC_BASE_URL=
# API 提供的本地产物最大字节数。留空默认 100 MiB。
ARTIFACT_MAX_READ_BYTES=104857600

# ── 上传媒体校验 ──────────────────────────────────────────────────
# 音频/视频上传在存储前由服务端 ffprobe 探测。
# 默认最大时长 1800 秒；设 0 关闭时长限制。
MEDIA_MAX_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe

# ── 产物存储：阿里云 OSS（生产必需）──────────────────────────────
# 仅开发时全部留空以使用上面的本地文件系统适配器。
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_TIMEOUT_MS=180000
OSS_RETRY_MAX=2
# 所有 OSS 对象的 key 前缀。留空无前缀。代码默认："bailian-studio"。
OSS_KEY_PREFIX=

# ── 客户端 Origin（Web/Vite）─────────────────────────────────────
# Vite 把 API origin 注入 apps/web。留空 = 同源：开发由 vite 代理 /api，
# 生产由 nginx 反代 /api，会话 cookie 同源携带。跨源部署时填完整 API origin。
# VITE_WEB_ORIGIN 仅作为 API auth-origin 兼容回退；优先用 AUTH_PUBLIC_WEB_ORIGIN。
VITE_API_ORIGIN=
VITE_WEB_ORIGIN=http://localhost:5002
