# pnpm strict node_modules（保留每个包仅可见其声明依赖）。
# 需要根级工具（tsx/vitest/dotenv-cli）经 turbo 的 PATH 注入解析。
shamefully-hoist=false
strict-peer-dependencies=true
auto-install-peers=true
# Volta/共享 store 环境下自动切换 packageManager 会递归启动 pnpm。
# 版本由 packageManager、CI pnpm/action-setup 和开发机检查共同约束。
manage-package-manager-versions=false
